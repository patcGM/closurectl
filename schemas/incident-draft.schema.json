{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/patcGM/closurectl/v1.0.0/schemas/incident-draft.schema.json",
  "title": "closurectl incident draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "created_at",
    "sources",
    "candidates",
    "limitations",
    "draft_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adapter",
          "collected_at",
          "artifact_digest",
          "complete"
        ],
        "properties": {
          "adapter": {
            "enum": [
              "github-read-only",
              "npm-read-only"
            ]
          },
          "collected_at": {
            "type": "string",
            "format": "date-time"
          },
          "artifact_digest": {
            "$ref": "#/$defs/digest"
          },
          "complete": {
            "type": "boolean"
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "draft_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "operation",
        "target",
        "phase"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "stop_minting",
            "cancel_pending",
            "revoke_descendants",
            "revoke_roots",
            "verify_sinks"
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "kind",
        "label",
        "revocable",
        "cost"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "revocable": {
          "type": "boolean"
        },
        "cost": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "enforcement": {
          "$ref": "#/$defs/enforcement"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "revocable": {
                "const": true
              }
            },
            "required": [
              "revocable"
            ]
          },
          "then": {
            "required": [
              "enforcement"
            ]
          },
          "else": {
            "not": {
              "required": [
                "enforcement"
              ]
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "provider",
        "resource_kind",
        "summary",
        "assumption",
        "mandatory",
        "provenance",
        "nodes",
        "edge"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "resource_kind": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "assumption": {
          "type": "string",
          "minLength": 1
        },
        "mandatory": {
          "type": "boolean"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_digest",
            "evidence_paths"
          ],
          "properties": {
            "source_digest": {
              "$ref": "#/$defs/digest"
            },
            "evidence_paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
              }
            }
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/node"
            },
            {
              "$ref": "#/$defs/node"
            }
          ],
          "items": false
        },
        "edge": {
          "$ref": "#/$defs/edge"
        }
      }
    }
  }
}
